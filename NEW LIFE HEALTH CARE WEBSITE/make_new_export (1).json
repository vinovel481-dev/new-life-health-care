<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>MAKE NEW — Smart School App</title>
  <meta name="description" content="MAKE NEW - Smart Connecter style school app demo (attendance, offline/online, Bluetooth, multi-language, YouTube learning content, exam marks)" />
  <style>
    :root{
      --accent:#0b74de;
      --muted:#666;
      --card:#fff;
      --bg:#f4f7fb;
      --max-width:1000px;
      --radius:12px;
    }
    *{box-sizing:border-box;font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Roboto,"Helvetica Neue",Arial;}
    body{margin:0;background:var(--bg);color:#222;display:flex;justify-content:center;padding:18px;}
    .app{width:100%;max-width:var(--max-width);}
    header{display:flex;align-items:center;gap:12px;margin-bottom:18px;}
    .logo{background:var(--card);padding:10px 14px;border-radius:12px;display:flex;gap:12px;align-items:center;box-shadow:0 2px 8px rgba(10,10,10,.05);}
    .logo h1{margin:0;font-size:18px;}
    .tag{font-size:12px;color:var(--muted);}
    .top-actions{margin-left:auto;display:flex;gap:8px;align-items:center;}
    button, input, select{font-size:14px;padding:8px;border-radius:8px;border:1px solid #ddd;background:#fff;}
    .grid{display:grid;grid-template-columns:1fr;gap:12px;}
    @media(min-width:900px){ .grid{grid-template-columns:1fr 360px;} }

    .card{background:var(--card);padding:14px;border-radius:var(--radius);box-shadow:0 6px 18px rgba(20,20,40,.04);}
    .section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
    .small{font-size:13px;color:var(--muted);}
    .btn-primary{background:var(--accent);color:#fff;border:0;padding:8px 10px;border-radius:8px;cursor:pointer;}
    .btn-ghost{background:transparent;border:1px solid #ddd;}
    .row{display:flex;gap:8px;align-items:center;}
    .badge{background:#eef6ff;color:var(--accent);padding:6px 8px;border-radius:999px;font-size:13px;}
    textarea{width:100%;min-height:80px;padding:8px;border-radius:8px;}

    .youtube-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;}
    .yt-card{background:#111;color:#fff;height:140px;border-radius:8px;display:flex;align-items:center;justify-content:center;}
    .controls{display:flex;gap:6px;flex-wrap:wrap;}
    .status{font-weight:600;}

    table{width:100%;border-collapse:collapse;}
    th,td{padding:8px;border-bottom:1px solid #eee;text-align:left;font-size:13px;}
    .center{text-align:center;}
    .note{font-size:13px;color:#555;margin-top:6px;}
    footer{margin-top:18px;text-align:center;color:var(--muted);font-size:13px;}
  </style>
</head>
<body>
  <div class="app">
    <header>
      <div class="logo">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden><rect width="24" height="24" rx="6" fill="#0b74de"/><path d="M6 12h12M12 6v12" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div>
          <h1>MAKE NEW</h1>
          <div class="tag">Smart School — attendance • learning • alerts</div>
        </div>
      </div>

      <div class="top-actions">
        <select id="langSelect" aria-label="Select language">
          <option value="en">English</option>
          <option value="ta">தமிழ் (Tamil)</option>
          <option value="hi">हिन्दी (Hindi)</option>
        </select>

        <button id="loginBtn" class="btn-primary">Login with Google</button>
        <button id="offlineBtn" class="btn-ghost">Check Offline</button>
      </div>
    </header>

    <main class="grid">
      <!-- Left column main content -->
      <section class="card">
        <div class="section-title">
          <strong id="welcomeTitle">Dashboard</strong>
          <div class="row">
            <span class="small">Status:</span>
            <span id="onlineStatus" class="badge">Online</span>
          </div>
        </div>

        <!-- Attendance Box -->
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
          <div style="flex:1;min-width:220px;" class="card">
            <div class="small">Bluetooth Attendance</div>
            <div class="note">Use this to mark students present via Bluetooth marker device (demo).</div>
            <div style="margin-top:8px;">
              <button id="btScan" class="btn-primary">Scan Bluetooth Device</button>
              <button id="markPresent" class="btn-ghost">Mark Present (simulate)</button>
            </div>
            <div id="btResult" class="note" style="margin-top:8px;">No device scanned.</div>
          </div>

          <div style="flex:1;min-width:220px;" class="card">
            <div class="small">Attendance Stats</div>
            <div style="margin-top:8px;">
              <label>Enter total classes this month: <input id="totalClasses" type="number" value="20" /></label>
              <label style="margin-left:8px;">Present count: <input id="presentCount" type="number" value="15" /></label>
              <div style="margin-top:8px;">
                <button id="calcPercent" class="btn-primary">Calculate %</button>
                <span id="percentDisplay" style="margin-left:12px;font-weight:700;"></span>
              </div>
              <div id="autoMailNote" class="note"></div>
            </div>
          </div>
        </div>

        <!-- YouTube Learning -->
        <div class="card" style="margin-bottom:12px;">
          <div class="section-title"><strong id="ytTitle">Study Materials (Classes 6–12)</strong>
            <div class="controls">
              <button class="btn-ghost" data-lang="en" onclick="switchYouTube('en')">English</button>
              <button class="btn-ghost" data-lang="ta" onclick="switchYouTube('ta')">தமிழ்</button>
              <button class="btn-ghost" data-lang="hi" onclick="switchYouTube('hi')">हिन्दी</button>
            </div>
          </div>

          <div class="small">Embedded YouTube playlists & videos — class wise</div>
          <div id="youtubeArea" class="youtube-grid" style="margin-top:8px;">
            <!-- JS will populate -->
          </div>
        </div>

        <!-- Exam Marks Upload -->
        <div class="card" style="margin-top:12px;">
          <div class="section-title"><strong>Exam Marks</strong>
            <div class="small">Upload CSV (studentId,name,subject,marks,maxMarks)</div>
          </div>
          <input id="fileInput" type="file" accept=".csv" />
          <div style="margin-top:8px;">
            <button id="loadMarks" class="btn-primary">Load & Display Marks</button>
          </div>
          <div id="marksTableWrapper" style="margin-top:12px;"></div>
        </div>
      </section>

      <!-- Right column -->
      <aside>
        <div class="card">
          <div class="section-title"><strong>Parent Audio Alerts (Tamil)</strong></div>
          <div class="small">Pre-recorded messages for parents in Tamil (or TTS)</div>
          <div style="margin-top:8px;">
            <button class="btn-primary" onclick="playParentAudio('ta')">Play Tamil Audio</button>
            <button class="btn-ghost" onclick="speakTTS('ta','உங்கள் மாணவர் இன்று பள்ளிக்கு வரவில்லை')">TTS Tamil (sample)</button>
          </div>
          <audio id="parentAudio" src="" controls style="margin-top:8px;display:none;"></audio>
          <div class="note">(Add recorded audio files to server and set their URLs in production.)</div>
        </div>

        <div class="card" style="margin-top:12px;">
          <div class="section-title"><strong>Emergency Alert</strong></div>
          <div class="small">Send emergency message to parents / school</div>
          <textarea id="emergencyMsg">Emergency! Please contact school immediately.</textarea>
          <div style="margin-top:8px;">
            <button id="sendEmergency" class="btn-primary">Send Emergency Alert</button>
            <button id="localNotify" class="btn-ghost">Local Notification</button>
          </div>
          <div class="note">Automatic SMS / email to parents needs server integration. Here we fallback to mailto: or show local notifications.</div>
        </div>

        <div class="card" style="margin-top:12px;">
          <div class="section-title"><strong>School-wide</strong></div>
          <div class="small">Manage multiple classes, teachers & students in one app</div>
          <div style="margin-top:8px;">
            <button id="demoBulk" class="btn-primary">Demo: Load Whole School (simulate)</button>
          </div>
          <div id="schoolNote" class="note" style="margin-top:8px;"></div>
        </div>
      </aside>
    </main>

    <footer>
      MAKE NEW — prototype • client demo. For real functionality (auth, email, DB), setup backend & cloud services.
    </footer>
  </div>

  <script>
    /* -------------------------
       Initial UI + Multilanguage
       ------------------------- */
    const strings = {
      en: {
        dashboard: "Dashboard",
        yt: "Study Materials (Classes 6–12)",
        playTamil: "Play Tamil Audio"
      },
      ta: {
        dashboard: "டாஷ்போர்டு",
        yt: "அறிவியல் கல்வி (6–12 வகுப்பு)",
        playTamil: "தமிழ் ஒலியை இயக்கவும்"
      },
      hi: {
        dashboard: "डैशबोर्ड",
        yt: "अध्ययन सामग्री (कक्षा 6–12)",
        playTamil: "तमिल ऑडियो चलाएँ"
      }
    };

    const langSelect = document.getElementById('langSelect');
    function setLang(l){
      langSelect.value = l;
      // update UI strings
      document.getElementById('welcomeTitle').textContent = strings[l].dashboard || strings.en.dashboard;
      document.getElementById('ytTitle').textContent = strings[l].yt || strings.en.yt;
      // update other text if needed
    }
    langSelect.addEventListener('change', e => setLang(e.target.value));
    setLang('en');

    /* -------------------------
       Online / Offline detection
       ------------------------- */
    const onlineStatus = document.getElementById('onlineStatus');
    function updateOnlineStatus(){
      if(navigator.onLine){
        onlineStatus.textContent = 'Online';
        onlineStatus.style.background = '#eef6ff';
      } else {
        onlineStatus.textContent = 'Offline';
        onlineStatus.style.background = '#ffecec';
      }
    }
    window.addEventListener('online', updateOnlineStatus);
    window.addEventListener('offline', updateOnlineStatus);
    updateOnlineStatus();
    document.getElementById('offlineBtn').addEventListener('click', ()=> alert('Navigator online: ' + navigator.onLine));

    /* -------------------------
       Service Worker - simple caching
       ------------------------- */
    if('serviceWorker' in navigator){
      try{
        navigator.serviceWorker.register('/sw.js').then(()=>console.log('ServiceWorker registered')).catch(()=>console.log('SW register fail'));
      } catch(e){ console.log('SW err', e) }
    }

    /* -------------------------
       Bluetooth Attendance (demo)
       ------------------------- */
    const btScan = document.getElementById('btScan');
    const btResult = document.getElementById('btResult');
    let lastDevice = null;

    btScan.addEventListener('click', async () => {
      if(!navigator.bluetooth){
        btResult.textContent = "Web Bluetooth not supported in this browser. Use Chrome on Android/desktop with flags.";
        return;
      }
      try{
        btResult.textContent = "Requesting device...";
        // This is a demo request - replace filters with your marker's service UUID
        const device = await navigator.bluetooth.requestDevice({
          // acceptAllDevices: true // use only for testing
          filters: [{namePrefix:'ATTEND'}],
          optionalServices: []
        });
        lastDevice = device;
        btResult.textContent = `Connected to: ${device.name || device.id}`;
      } catch(err){
        btResult.textContent = 'Bluetooth scan canceled or failed: ' + (err.message || err);
      }
    });

    // simulate marking present
    document.getElementById('markPresent').addEventListener('click', () => {
      // In production: when device detected, send studentId + timestamp to backend
      const now = new Date().toLocaleString();
      btResult.textContent = `Marked present at ${now} ${lastDevice ? 'via ' + (lastDevice.name||lastDevice.id) : '(simulated)'}`;
      // optional: store in localStorage attendance list
      const attendances = JSON.parse(localStorage.getItem('attendances')||'[]');
      attendances.push({studentId: 'SIM001', name:'Demo Student', time: now});
      localStorage.setItem('attendances', JSON.stringify(attendances));
    });

    /* -------------------------
       Attendance percentage logic + auto-mail fallback
       ------------------------- */
    document.getElementById('calcPercent').addEventListener('click', () => {
      const total = Number(document.getElementById('totalClasses').value) || 0;
      const present = Number(document.getElementById('presentCount').value) || 0;
      const percent = total>0 ? Math.round((present/total)*100) : 0;
      document.getElementById('percentDisplay').textContent = percent + '%';
      const note = document.getElementById('autoMailNote');
      if(percent < 50){
        note.innerHTML = `Attendance below 50%. Auto-mail will be sent to parents (mailto fallback).`;
        // Auto mail fallback (opens user's email client). For real automatic sending use server.
        const parentEmail = prompt('Enter parent email for demo mail (or leave blank to skip):','parent@example.com');
        if(parentEmail){
          const subject = encodeURIComponent('Attendance Alert: Below 50%');
          const body = encodeURIComponent(`Dear Parent,\n\nThis is to inform you that your child's attendance is ${percent}%. Please contact the school.\n\nRegards,\nMAKE NEW`);
          window.location.href = `mailto:${parentEmail}?subject=${subject}&body=${body}`;
        }
      } else {
        note.textContent = 'Attendance OK.';
      }
    });

    /* -------------------------
       YouTube section (embeds)
       ------------------------- */
    const youtubeArea = document.getElementById('youtubeArea');
    // sample video ids for demo (replace with real playlists)
    const ytSamples = {
      en: ['dQw4w9WgXcQ','3JZ_D3ELwOQ','oHg5SJYRHA0'],
      ta: ['kJQP7kiw5Fk','fRh_vgS2dFE','RgKAFK5djSk'],
      hi: ['Zi_XLOBDo_Y','YlUKcNNmywk','L_jWHffIx5E']
    };
    function switchYouTube(lang='en'){
      youtubeArea.innerHTML = '';
      (ytSamples[lang]||ytSamples.en).forEach(id=>{
        const div = document.createElement('div');
        div.className = 'yt-card';
        div.innerHTML = `<iframe width="100%" height="140" src="https://www.youtube.com/embed/${id}" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        youtubeArea.appendChild(div);
      });
    }
    switchYouTube('en');

    /* -------------------------
       Parent audio & TTS
       ------------------------- */
    function playParentAudio(lang){
      // demo: we use TTS; in production replace with recorded audio file URL
      const text = (lang==='ta') ? 'உங்கள் மாணவர் இன்று பள்ளிக்கு வரவில்லை' : (lang==='hi') ? 'आपका छात्र आज विद्यालय नहीं आया' : 'Your child is absent today';
      speakTTS(lang, text);
    }
    function speakTTS(lang, text){
      if('speechSynthesis' in window){
        const utter = new SpeechSynthesisUtterance(text);
        // set language
        utter.lang = (lang==='ta') ? 'ta-IN' : (lang==='hi') ? 'hi-IN' : 'en-IN';
        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(utter);
      } else {
        alert('TTS not supported in this browser. In production, provide recorded audio files.');
      }
    }

    /* -------------------------
       Emergency alert (mailto fallback & notification)
       ------------------------- */
    document.getElementById('sendEmergency').addEventListener('click', () => {
      const msg = document.getElementById('emergencyMsg').value;
      // Demo: mailto fallback - collect parent emails from DB in production
      const parentEmail = prompt('Enter parent email for emergency (demo):','parent@example.com');
      if(parentEmail){
        const subject = encodeURIComponent('Emergency Alert from School');
        const body = encodeURIComponent(msg + '\n\nSent via MAKE NEW');
        window.location.href = `mailto:${parentEmail}?subject=${subject}&body=${body}`;
      } else {
        alert('No parent email entered. In production use server to SMS/Email all parents automatically.');
      }
    });
    document.getElementById('localNotify').addEventListener('click', async () => {
      if('Notification' in window){
        if(Notification.permission === 'granted'){
          new Notification('MAKE NEW', {body: document.getElementById('emergencyMsg').value});
        } else {
          const perm = await Notification.requestPermission();
          if(perm === 'granted') new Notification('MAKE NEW', {body: document.getElementById('emergencyMsg').value});
        }
      } else alert('Notifications not supported - implement push notifications via Service Worker & backend.');
    });

    /* -------------------------
       Demo: load whole school (simulate)
       ------------------------- */
    document.getElementById('demoBulk').addEventListener('click', () => {
      // Simulate loading school data
      const school = {name:'Demo School', classes:12, students: 850};
      document.getElementById('schoolNote').textContent = `Loaded ${school.name}. Classes: ${school.classes}, Total Students: ${school.students} (simulated)`;
    });

    /* -------------------------
       CSV upload and display marks
       Simple CSV parser
       ------------------------- */
    function parseCSV(text){
      const lines = text.trim().split(/\r?\n/);
      const rows = lines.map(r => r.split(',').map(c => c.trim()));
      return rows;
    }
    document.getElementById('loadMarks').addEventListener('click', async () => {
      const fileInput = document.getElementById('fileInput');
      if(!fileInput.files.length){ alert('Select CSV file first'); return; }
      const f = fileInput.files[0];
      const txt = await f.text();
      const rows = parseCSV(txt);
      // expecting header or no header: studentId,name,subject,marks,maxMarks
      const wrapper = document.getElementById('marksTableWrapper');
      let html = '<table><thead><tr><th>Student ID</th><th>Name</th><th>Subject</th><th>Marks</th><th>Max</th></tr></thead><tbody>';
      rows.forEach(r=>{
        if(r.length>=5 || r.length===5){}
        html += `<tr><td>${r[0]||''}</td><td>${r[1]||''}</td><td>${r[2]||''}</td><td>${r[3]||''}</td><td>${r[4]||''}</td></tr>`;
      });
      html += '</tbody></table>';
      wrapper.innerHTML = html;
    });

    /* -------------------------
       Login with Google placeholder
       NOTE: To securely login using Gmail, implement OAuth 2.0 on backend.
       ------------------------- */
    document.getElementById('loginBtn').addEventListener('click', ()=>{
      alert('This is a placeholder for Google OAuth login. Implement OAuth 2.0 on backend (client id, redirect uri, server token exchange).');
      // Example flow: redirect user to Google OAuth consent screen -> exchange code at your backend -> create session cookie
      // For demo: simulate logged in user:
      localStorage.setItem('user','demo_teacher@gmail.com');
      document.getElementById('loginBtn').textContent = 'Logged in (demo)';
    });

    /* -------------------------
       Notes in code: automatic email send & backend
       - For automatic emailing when attendance < 50% without user interaction, you must:
         1) Have backend server that verifies condition (cron or event-driven).
         2) Use SMTP provider or transactional email service (SendGrid, Mailgun) to send emails to parents.
         3) Store parent emails in DB and link to student ID.
       - For Gmail login: implement OAuth 2.0 with server-side exchange.
       - For storing attendance/school data: use database (Firebase Firestore, Supabase, PostgreSQL).
       - For push notifications: implement Push API + Service Worker + server push subscription.
       - For Bluetooth markers: hardware should broadcast a known ID or advertise a known service UUID; server receives attendance updates via device or gateway.
       ------------------------- */

  </script>
</body>
</html>

<!-- BEGIN: State Board Lessons (English / Tamil) -->
<style>
  /* small styles for the lessons section */
  .lessons-card { background:#fff;padding:12px;border-radius:12px;box-shadow:0 6px 16px rgba(10,10,30,.05); }
  .lessons-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px;}
  .lessons-row select, .lessons-row button{padding:8px;border-radius:8px;border:1px solid #ddd;background:#fff;}
  .lessons-embed{width:100%;aspect-ratio:16/9;border-radius:8px;overflow:hidden;border:1px solid #eee;}
  @media(min-width:900px){ .lessons-grid{display:grid;grid-template-columns:1fr 360px;gap:12px;} }
</style>

<section class="card lessons-card" id="stateBoardLessons">
  <div class="section-title">
    <strong>State Board Lessons — Classes 6 to 12</strong>
    <div class="small">Choose language & class to load official state board playlists / videos</div>
  </div>

  <div class="lessons-row">
    <label for="lessonLang">Language:</label>
    <select id="lessonLang" aria-label="Language select">
      <option value="en">English</option>
      <option value="ta">தமிழ் (Tamil)</option>
    </select>

    <label for="lessonClass">Class:</label>
    <select id="lessonClass" aria-label="Class select">
      <option value="6">Class 6</option>
      <option value="7">Class 7</option>
      <option value="8">Class 8</option>
      <option value="9">Class 9</option>
      <option value="10">Class 10</option>
      <option value="11">Class 11</option>
      <option value="12">Class 12</option>
    </select>

    <button id="loadLesson" class="btn-primary">Load Lesson Playlist</button>
  </div>

  <div style="display:flex;gap:12px;flex-wrap:wrap;">
    <div style="flex:1;min-width:280px;">
      <div class="small">Embedded Playlist / Video</div>
      <div id="lessonEmbed" class="lessons-embed" style="margin-top:8px;">
        <!-- iframe will be injected here -->
        <iframe id="lessonIframe" src="" width="100%" height="100%" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>

    <aside style="width:320px;min-width:240px;">
      <div class="card">
        <div class="section-title"><strong>Details</strong></div>
        <div class="small" id="lessonMeta">Choose language and class, then press "Load".</div>
        <div style="margin-top:8px;">
          <div class="small"><strong>Source:</strong> State Board / Official YouTube channel (replace with your board links)</div>
          <div class="note" style="margin-top:8px;">Tip: Use YouTube <em>playlist ID</em> for a series of videos, or a single <em>video ID</em> for one lecture.</div>
        </div>
      </div>

      <div class="card" style="margin-top:12px;">
        <div class="small"><strong>How to add your own links</strong></div>
        <ol style="font-size:13px;margin-top:6px;">
          <li>Find the State Board playlist on YouTube → copy the playlist ID (the value after <code>list=</code> in the URL).</li>
          <li>Replace the placeholder IDs in the `lessonsMap` object inside the script below.</li>
          <li>Optionally add separate playlist IDs for subjects (Maths, Science) by storing subject-level ids in the map.</li>
        </ol>
      </div>
    </aside>
  </div>
</section>

<script>
  /**
   * lessonsMap structure:
   * lessonsMap[language][class] = { type: 'playlist'|'video', id: 'PLAYLIST_OR_VIDEO_ID', title: 'optional title', sourceUrl: 'optional full youtube url' }
   *
   * Replace the placeholder ids with real State Board playlist or video ids.
   */
  const lessonsMap = {
    en: {
      6: { type:'playlist', id: 'PL_PLACEHOLDER_EN_CLASS6', title:'Class 6 - English - State Board', sourceUrl: 'https://www.youtube.com/playlist?list=PL_PLACEHOLDER_EN_CLASS6' },
      7: { type:'playlist', id: 'PL_PLACEHOLDER_EN_CLASS7' },
      8: { type:'playlist', id: 'PL_PLACEHOLDER_EN_CLASS8' },
      9: { type:'playlist', id: 'PL_PLACEHOLDER_EN_CLASS9' },
      10: { type:'playlist', id: 'PL_PLACEHOLDER_EN_CLASS10' },
      11: { type:'playlist', id: 'PL_PLACEHOLDER_EN_CLASS11' },
      12: { type:'playlist', id: 'PL_PLACEHOLDER_EN_CLASS12' }
    },
    ta: {
      6: { type:'playlist', id: 'PL_PLACEHOLDER_TA_CLASS6', title: